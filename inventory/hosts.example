# Copy to inventory/hosts (gitignored) and fill in your actual hostnames/IPs.

[local]
127.0.0.1 ansible_connection=local

# Standalone, non-k8s home-server boxes (each running its own discrete
# services — media server, file server, etc.)
[fileservers]
fileserver1.example.com

# Kubernetes bare-metal nodes
[kube]
node1.example.com
node2.example.com
node3.example.com
node4.example.com

[kube_control_plane]
node1.example.com
node2.example.com
node3.example.com

[etcd]
node1.example.com
node2.example.com
node3.example.com

[kube_node]
node4.example.com

[calico_rr]

[k8s_cluster:children]
kube_control_plane
kube_node

# AWS EC2 edge node — generated by Terraform into inventory/aws_hosts.
# To use manually (before first terraform apply), add the EIP here:
# [aws]
# 1.2.3.4 ansible_user=admin
