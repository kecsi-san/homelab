---
# Sensitive values — gitignored, never commit.
# Copy this file to secrets.yml and fill in your values.
# Non-sensitive infrastructure values are in vars.yml (committed).

acme_email: "your@email.com"

ansible_ssh_user: your_ssh_user
admin_user: your_admin_user

# MikroTik router credentials
mikrotik_user: "ansible"
mikrotik_password: "changeme"

# Cloudflare zone settings (configure-cloudflare.yml)
cloudflare_api_token: "your-dns-api-token"          # Zone:DNS:Edit scope
cloudflare_settings_token: "your-settings-api-token"  # Zone:Settings:Edit scope (can be same token if it has both)
cloudflare_zone_id: "your-zone-id"
homelab_wan_ip: "your-public-wan-ip"  # used for non-proxied DNS records (e.g. Minecraft)

# AWS EC2 edge node (ec2-core.yml, ec2-mail.yml, ec2-wireguard.yml)
ec2_ssh_key_file: "~/.ssh/your-ec2-key.pem"   # path to EC2 SSH private key
aws_access_key_id: "your-access-key-id"
aws_secret_access_key: "your-secret-access-key"
aws_region: "eu-west-1"

# Duo MFA for SSH (ec2-core.yml, configure_duo-ssh)
# Copy these from the host's existing /etc/duo/login_duo.conf (same Duo application).
duo_ikey: "your-duo-integration-key"
duo_skey: "your-duo-secret-key"
duo_api_host: "api-xxxxxxxx.duosecurity.com"

# Email server domains (ec2-mail.yml)
# All domains must have Route53 zones or Cloudflare zones configured
email_domains:
  - "example.com"
  - "example.net"

# Named system users on the EC2 edge node (ec2-core.yml)
# sudo: true adds the user to the 'sudo' group.
# Home directories are created automatically. Pin uid when rsync'ing data from an
# existing server so file ownership matches without a chown pass.
ec2_users:
  - name: alice
    uid: 1000
    comment: Alice Smith
    groups: [www-data]
    sudo: true
    ssh_key: "ssh-ed25519 AAAA... alice@laptop"
  - name: bob
    uid: 1001
    comment: Bob Jones
    # Plaintext (hashed by setup_users at apply time, never written to disk as
    # plaintext) — deliberate for hosts where SSH is key-only/password auth is
    # disabled and this password only gates something like PAM email login over
    # SSL: storing plaintext in Vault means a forgotten password is recoverable,
    # not just resettable. Omit entirely for a locked ('!') account.
    password: "correct-horse-battery-staple"

# Users to remove on next run (home dirs preserved for data migration)
ec2_users_absent: []

# Apache ServerAdmin email + HashiCorp Vault external address (ec2-web.yml, ec2-vault.yml)
apache_server_admin: webmaster@example.com
vault_api_addr: "https://vault.example.com"

# Vault AppRole credentials for Ansible (aws.yml vault_kv2_get lookups).
# See terraform/vault/README.md bootstrap step 2 to generate these.
vault_ansible_role_id: "your-approle-role-id"
vault_ansible_secret_id: "your-approle-secret-id"

# System aliases (/etc/aliases)
aliases_root: admin
extra_aliases:
  fail2ban: admin
  wiki: admin

# Virtual mailbox users -> Postfix virtual address map (setup_email-server's
# postfix-virtual.j2). Auth is PAM/system-password based (see ec2_users above),
# not password_hash here — this only controls which addresses route to which
# local system user. domains[].aliases are extra local-parts that also route to
# this user on that domain (e.g. nicknames); include_self (default true) controls
# whether user.name itself is registered on that domain — set false where the
# person's own username was never actually registered there.
mailbox_users:
  - name: admin
    domains:
      - name: "example.com"
        aliases: [firstname]
      - name: "example.net"
        aliases: [firstname]
      - name: "example.org"
        include_self: false
        aliases: [firstname, sales, support]

# TLS certificates to issue via certbot DNS-01/Route53 (ec2-web.yml)
# Each entry issues one cert covering the primary domain + any SANs.
# Vhosts reference the primary domain name via ssl_cert_domain.
apache_certs:
  - domain: "example.com"
    extra_sans:
      - "www.example.com"
      - "vault.example.com"
  - domain: "example.net"
    extra_sans:
      - "www.example.net"

# Apache virtual hosts (ec2-web.yml)
# proxy_pass and docroot are mutually exclusive.
# ssl_cert_domain must match a domain in apache_certs above.
apache_vhosts:
  - name: "www.example.com"
    server_alias:
      - "example.com"
    docroot: "/var/www/example.com"
    ssl: true
    ssl_cert_domain: "example.com"
  - name: "vault.example.com"
    proxy_pass: "http://127.0.0.1:8200/"
    ssl: true
    ssl_cert_domain: "example.com"
  - name: "www.example.net"
    server_alias:
      - "example.net"
    docroot: "/var/www/example.net"
    ssl: true
    ssl_cert_domain: "example.net"
