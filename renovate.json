{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "assignees": [
    "kecsi-san"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/kube-gitops/k8s/apps/.+\\.yaml/",
      "/kube-gitops/k3s/apps/.+\\.yaml/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/kube-gitops/k8s/values/.+\\.yaml/",
      "/kube-gitops/k3s/values/.+\\.yaml/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "argocd"
      ],
      "groupName": "helm charts",
      "commitMessagePrefix": "chore(helm):"
    },
    {
      "matchManagers": [
        "helm-values"
      ],
      "groupName": "app images",
      "commitMessagePrefix": "chore(images):"
    },
    {
      "matchManagers": [
        "kubernetes"
      ],
      "groupName": "raw manifest images",
      "commitMessagePrefix": "chore(images):"
    },
    {
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "cloudflare/cloudflared"
      ],
      "groupName": "cloudflared",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "alpine/k8s"
      ],
      "allowedVersions": "<1.36",
      "description": "kubectl client must stay within one minor of the 1.35 cluster"
    },
    {
      "matchPackageNames": [
        "codeberg.org/forgejo/forgejo"
      ],
      "allowedVersions": "<16",
      "description": "Stay on the 15.0 LTS line (supported until 2027-07); the next LTS is 19.0 in 2027-04. Patch releases only."
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "automerge": true,
      "commitMessagePrefix": "chore(ci):"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "Python dependencies",
      "commitMessagePrefix": "chore(deps):"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/kube-gitops/k8s/.+\\.yaml/",
      "/kube-gitops/k3s/.+\\.yaml/"
    ]
  }
}
