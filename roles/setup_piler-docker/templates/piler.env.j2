# Managed by Ansible (role setup_piler-docker). Secrets: mode 0600, never commit.
# Single quotes keep compose from interpolating the $ signs in a crypt hash.
MYSQL_PASSWORD='{{ piler_db_password }}'
{% if piler_admin_password_hash | length > 0 %}
ADMIN_USER_PASSWORD_HASH='{{ piler_admin_password_hash }}'
{% endif %}
{% if piler_auditor_password_hash | length > 0 %}
AUDITOR_USER_PASSWORD_HASH='{{ piler_auditor_password_hash }}'
{% endif %}
