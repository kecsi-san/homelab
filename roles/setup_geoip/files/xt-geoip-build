#!/usr/bin/python3
"""Build the xt_geoip country files from MaxMind's GeoLite2-Country.mmdb.

xtables-addons' xt_geoip module reads one packed file per country from
/usr/share/xt_geoip:  <CC>.iv4  = sorted, non-overlapping (start, end) pairs of
4-byte big-endian addresses, <CC>.iv6 = the same with 16-byte addresses.
Debian only ships a builder for MaxMind's CSV download; geoipupdate fetches the
.mmdb editions, so this script builds the same files from the .mmdb instead.

Typical use (chained after geoipupdate by systemd OnSuccess=):
    xt-geoip-build --reload-rules

Test without touching live files:
    xt-geoip-build --dest /tmp/xt_geoip_test
    xt-geoip-build --dest /tmp/xt_geoip_test --lookup 203.0.113.10 8.8.8.8
"""
import argparse
import bisect
import ipaddress
import os
import random
import shlex
import struct
import subprocess
import sys
import tempfile

DEFAULT_SRC = "/var/lib/GeoIP/GeoLite2-Country.mmdb"
DEFAULT_DEST = "/usr/share/xt_geoip"
MIN_COUNTRIES = 200      # sanity floor: abort instead of installing a broken database
MIN_V4_RANGES = 100000

# IPv6 aliases of IPv4 space inside the .mmdb tree; the CSV builder never emits them.
SKIP_V6 = [ipaddress.ip_network("2002::/16"), ipaddress.ip_network("2001::/32"),
           ipaddress.ip_network("::ffff:0:0/96")]
V4_IN_V6 = ipaddress.ip_network("::/96")


def merge(ranges):
    """Sort and merge overlapping or adjacent (start, end) integer ranges."""
    ranges.sort()
    out = []
    for start, end in ranges:
        if out and start <= out[-1][1] + 1:
            if end > out[-1][1]:
                out[-1][1] = end
        else:
            out.append([start, end])
    return [(s, e) for s, e in out]


def collect(src):
    """Return ({cc: [v4 ranges]}, {cc: [v6 ranges]}) from the .mmdb."""
    import maxminddb  # deferred so the pure functions can be tested without it
    v4, v6 = {}, {}
    with maxminddb.open_database(src) as reader:
        for net, rec in reader:
            country = (rec.get("country") or rec.get("registered_country") or {})
            cc = country.get("iso_code")
            if not cc:
                continue
            if isinstance(net, ipaddress.IPv6Network):
                if any(net.subnet_of(s) for s in SKIP_V6):
                    continue
                if net.subnet_of(V4_IN_V6):
                    # IPv4 stored under ::/96 by older libraries: convert back to IPv4
                    start = int(net.network_address)
                    end = int(net.broadcast_address)
                    v4.setdefault(cc, []).append((start, end))
                    continue
                v6.setdefault(cc, []).append((int(net.network_address), int(net.broadcast_address)))
            else:
                v4.setdefault(cc, []).append((int(net.network_address), int(net.broadcast_address)))
    return ({k: merge(v) for k, v in v4.items()}, {k: merge(v) for k, v in v6.items()})


def pack_v4(ranges):
    return b"".join(struct.pack(">II", s, e) for s, e in ranges)


def pack_v6(ranges):
    return b"".join(s.to_bytes(16, "big") + e.to_bytes(16, "big") for s, e in ranges)


def unpack(data, width):
    out = []
    step = width * 2
    for i in range(0, len(data), step):
        out.append((int.from_bytes(data[i:i + width], "big"),
                    int.from_bytes(data[i + width:i + step], "big")))
    return out


def write_all(outdir, v4, v6):
    for cc, rng in v4.items():
        with open(os.path.join(outdir, cc + ".iv4"), "wb") as fh:
            fh.write(pack_v4(rng))
    for cc, rng in v6.items():
        with open(os.path.join(outdir, cc + ".iv6"), "wb") as fh:
            fh.write(pack_v6(rng))


def load_dir(directory):
    """Read a directory of .iv4/.iv6 files back into sorted (start, end, cc) lists."""
    v4, v6 = [], []
    for name in os.listdir(directory):
        cc, _, ext = name.partition(".")
        if ext not in ("iv4", "iv6"):
            continue
        width = 4 if ext == "iv4" else 16
        with open(os.path.join(directory, name), "rb") as fh:
            data = fh.read()
        if len(data) % (width * 2):
            raise ValueError("%s: size %d is not a multiple of %d" % (name, len(data), width * 2))
        (v4 if width == 4 else v6).extend((s, e, cc) for s, e in unpack(data, width))
    v4.sort()
    v6.sort()
    return v4, v6


def lookup_in(table, addr_int):
    """Country for an address in a sorted (start, end, cc) list, or None."""
    i = bisect.bisect_right(table, (addr_int, float("inf"), "")) - 1
    if i >= 0 and table[i][0] <= addr_int <= table[i][1]:
        return table[i][2]
    return None


def check_no_overlap(table, label):
    for a, b in zip(table, table[1:]):
        if b[0] <= a[1]:
            raise ValueError("%s: overlapping ranges %s and %s" % (label, a, b))


def verify(outdir, src, samples):
    """Read the new files back and compare random addresses with the .mmdb itself."""
    import maxminddb
    t4, t6 = load_dir(outdir)
    check_no_overlap(t4, "iv4")
    check_no_overlap(t6, "iv6")
    rng = random.Random(1234)
    bad = 0
    with maxminddb.open_database(src) as reader:
        for table, bits, label in ((t4, 32, "v4"), (t6, 128, "v6")):
            if not table:
                continue
            for _ in range(samples):
                s, e, cc = table[rng.randrange(len(table))]
                addr = rng.randint(s, e)
                ip = str(ipaddress.ip_address(addr) if bits == 128 else ipaddress.IPv4Address(addr))
                rec = reader.get(ip) or {}
                want = (rec.get("country") or rec.get("registered_country") or {}).get("iso_code")
                if want != cc:
                    bad += 1
                    print("MISMATCH %s %s files=%s mmdb=%s" % (label, ip, cc, want), file=sys.stderr)
    if bad:
        raise SystemExit("verification failed: %d mismatches" % bad)


def install(newdir, dest):
    """Atomically replace each country file in dest, then drop country files that disappeared."""
    os.makedirs(dest, exist_ok=True)
    fresh = set(os.listdir(newdir))
    for name in fresh:
        tmp = os.path.join(dest, "." + name + ".tmp")
        with open(os.path.join(newdir, name), "rb") as fi, open(tmp, "wb") as fo:
            fo.write(fi.read())
            fo.flush()
            os.fsync(fo.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, os.path.join(dest, name))
    for name in os.listdir(dest):
        if name.endswith((".iv4", ".iv6")) and name not in fresh:
            os.remove(os.path.join(dest, name))


def reload_rules(dry_run=False):
    """Re-insert every iptables/ip6tables rule that uses -m geoip, in place (-R keeps position).

    The module loads the country ranges into the kernel when a rule is added, so a
    rule that was added before the files changed keeps the old data until replaced.
    """
    for tool in ("iptables", "ip6tables"):
        try:
            res = subprocess.run([tool, "-w", "5", "-S"], capture_output=True, text=True, check=True)
        except (FileNotFoundError, subprocess.CalledProcessError):
            continue
        counters = {}
        for line in res.stdout.splitlines():
            parts = shlex.split(line)
            if len(parts) < 2 or parts[0] != "-A":
                continue
            chain = parts[1]
            counters[chain] = counters.get(chain, 0) + 1
            if "geoip" in parts:
                cmd = [tool, "-w", "5", "-R", chain, str(counters[chain])] + parts[2:]
                print("reload:", " ".join(shlex.quote(c) for c in cmd))
                if not dry_run:
                    subprocess.run(cmd, check=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--src", default=DEFAULT_SRC, help="GeoLite2-Country.mmdb (default %(default)s)")
    ap.add_argument("--dest", default=DEFAULT_DEST, help="output directory (default %(default)s)")
    ap.add_argument("--reload-rules", action="store_true", help="re-insert geoip firewall rules after installing")
    ap.add_argument("--dry-run", action="store_true", help="with --reload-rules: only print the iptables commands")
    ap.add_argument("--samples", type=int, default=5000, help="random addresses to verify per family (default %(default)s)")
    ap.add_argument("--lookup", nargs="+", metavar="IP", help="only look up IPs in --dest and exit")
    args = ap.parse_args()

    if args.lookup:
        t4, t6 = load_dir(args.dest)
        for ip in args.lookup:
            addr = ipaddress.ip_address(ip)
            table = t4 if addr.version == 4 else t6
            print("%s %s" % (ip, lookup_in(table, int(addr)) or "-"))
        return

    v4, v6 = collect(args.src)
    if len(v4) < MIN_COUNTRIES or sum(len(r) for r in v4.values()) < MIN_V4_RANGES:
        raise SystemExit("refusing to install: only %d countries / %d IPv4 ranges (is %s complete?)"
                         % (len(v4), sum(len(r) for r in v4.values()), args.src))

    with tempfile.TemporaryDirectory(prefix="xt_geoip.new.") as newdir:
        write_all(newdir, v4, v6)
        verify(newdir, args.src, args.samples)
        install(newdir, args.dest)
    print("installed %d IPv4 / %d IPv6 country files into %s" % (len(v4), len(v6), args.dest))

    if args.reload_rules:
        reload_rules(dry_run=args.dry_run)


if __name__ == "__main__":
    main()
