#!/bin/bash
# Managed by Ansible (role setup_restic-backup).
# File system backup to a restic repository, one snapshot per directory.
# Settings come from {{ restic_backup_config_dir }}/env (RESTIC_REPOSITORY, RESTIC_PASSWORD).
set -euo pipefail

set -a
# shellcheck disable=SC1091
. {{ restic_backup_config_dir }}/env
set +a

stamp() { date +"%Y.%m.%d %T"; }

run_backup() {
  echo "[$(stamp)] [load: $(cut -d' ' -f1-3 /proc/loadavg)] restic backup started."
  failed=0
  for dir in {% for d in restic_backup_dirs %}{{ d | quote }} {% endfor %}; do
    echo "[$(stamp)] backing up $dir"
    rc=0
    restic -q backup --tag {{ restic_backup_tag | quote }} {% for a in restic_backup_extra_args %}{{ a | quote }} {% endfor %}"$dir" || rc=$?
    # exit code 3: the backup is complete but some files could not be read; not a failure
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then
      echo "[$(stamp)] ERROR: restic exited with $rc for $dir" >&2
      failed=1
    fi
  done

  if [ "$failed" -ne 0 ]; then
    echo "[$(stamp)] finished with errors." >&2
    return 1
  fi
  echo "[$(stamp)] all done."
}

{% if restic_backup_mail_to | length > 0 %}
# Run, keep the output for the journal and for the report mail.
rc=0
out=$(run_backup 2>&1) || rc=$?
printf '%s\n' "$out"
status=OK
[ "$rc" -eq 0 ] || status=FAILED
{% if restic_backup_mail_only_on_failure %}
if [ "$rc" -ne 0 ]; then
{% endif %}
from={{ restic_backup_mail_from | quote }}
[ -n "$from" ] || from="root@$(hostname -f 2>/dev/null || hostname)"
{
  printf 'To: %s\n' {{ restic_backup_mail_to | quote }}
  printf 'From: %s\n' "$from"
  printf 'Subject: restic backup on %s: %s\n' "$(hostname -s)" "$status"
  printf 'Auto-Submitted: auto-generated\n'
  printf 'Content-Type: text/plain; charset=UTF-8\n\n'
  printf '%s\n' "$out"
} | /usr/sbin/sendmail -t -oi -f "$from" || echo "[$(stamp)] WARNING: could not send the report mail." >&2
{% if restic_backup_mail_only_on_failure %}
fi
{% endif %}
exit "$rc"
{% else %}
run_backup
{% endif %}
