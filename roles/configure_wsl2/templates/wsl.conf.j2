# Managed by Ansible (configure_wsl2 role) — do not edit by hand
[automount]
enabled = false
# root = /mnt
options = "metadata,uid=1000,gid=1000,umask=077,fmask=11,case=off"
mountFsTab = true

[network]
hostname = {{ ansible_hostname }}
generateHosts = false
generateResolvConf = false

[interop]
enabled = true
appendWindowsPath = false

[user]
default = {{ admin_user }}

[boot]
systemd = true
initTimeout = 10000
# One-shot clock pre-correction before systemd starts — the WSL2 VM's
# clock drifts while the Windows host sleeps, and chronyd's normal
# slew-then-decide-to-step cycle takes 30-60s to catch up, well past
# initTimeout, producing a cosmetic "Failed to start the systemd user
# session" warning even though the session starts fine moments later.
command = chronyd -q
