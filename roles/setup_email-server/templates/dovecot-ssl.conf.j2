# Managed by Ansible — do not edit manually
# Dovecot 2.4 SSL configuration
ssl = required
ssl_min_protocol = TLSv1.2
# ssl_cipher_list was removed in Dovecot 2.4 — TLS 1.3 handles cipher selection automatically.
# ssl_prefer_server_ciphers likewise removed; OpenSSL defaults are secure with TLSv1.2+ minimum.

ssl_server {
  cert_file = {{ certbot_cert_dir }}/{{ mail_hostname }}/fullchain.pem
  key_file  = {{ certbot_cert_dir }}/{{ mail_hostname }}/privkey.pem
}
