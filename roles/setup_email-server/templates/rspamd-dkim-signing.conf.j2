enabled = true;
path = "{{ rspamd_dkim_key_dir }}/$domain.$selector.key";
selector = "{{ dkim_selector }}";
sign_authenticated = true;
sign_local = true;
allow_username_mismatch = true;
{% if dkim_domain_selectors %}

# Domains whose key uses another selector (for example keys carried over from another server)
domain {
{% for d, sel in dkim_domain_selectors.items() %}
    {{ d }} {
        selector = "{{ sel }}";
        path = "{{ rspamd_dkim_key_dir }}/{{ d }}.{{ sel }}.key";
    }
{% endfor %}
}
{% endif %}
