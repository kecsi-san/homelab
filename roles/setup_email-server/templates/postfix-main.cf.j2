# Managed by Ansible — do not edit manually
myhostname = {{ mail_hostname }}
mydomain = {{ email_domains | first }}
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4

# No local delivery — all mail goes to virtual mailboxes
mydestination =
local_recipient_maps =
local_transport = error:local delivery disabled

# Virtual mailbox setup
virtual_mailbox_domains = {% for d in email_domains %}{{ d }}{% if not loop.last %}, {% endif %}{% endfor %}

virtual_mailbox_base = {{ vmail_home }}
virtual_mailbox_maps = hash:{{ postfix_config_dir }}/vmailbox
virtual_minimum_uid = 100
virtual_uid_maps = static:{{ vmail_uid }}
virtual_gid_maps = static:{{ vmail_gid }}

# Deliver via Dovecot LMTP
virtual_transport = lmtp:unix:private/dovecot-lmtp

# TLS
smtpd_tls_cert_file = {{ certbot_cert_dir }}/{{ mail_hostname }}/fullchain.pem
smtpd_tls_key_file  = {{ certbot_cert_dir }}/{{ mail_hostname }}/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtp_tls_security_level = may
smtpd_tls_loglevel = 1

# SASL auth via Dovecot
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination,
    check_policy_service unix:private/policyd-spf,
    check_policy_service inet:127.0.0.1:{{ postgrey_port }}

# SPF policy daemon timeout
policyd-spf_time_limit = 3600

# OpenDKIM + OpenDMARC milters
milter_default_action = accept
milter_protocol = 6
smtpd_milters = local:/run/opendkim/opendkim.sock, local:/run/opendmarc/opendmarc.sock
non_smtpd_milters = $smtpd_milters

# SpamAssassin content filter (inbound only — submission overrides this to empty)
content_filter = spamassassin

# Limits
message_size_limit = 52428800
mailbox_size_limit = 0
