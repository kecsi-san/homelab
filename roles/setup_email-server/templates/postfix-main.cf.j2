# Managed by Ansible — do not edit manually
biff = no
append_dot_mydomain = no
disable_vrfy_command = yes

myhostname = {{ mail_hostname }}
mydomain = {{ email_domains | first }}
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4

# All served domains — local delivery to system users
mydestination = $myhostname, localhost{% for d in email_domains %}, {{ d }}, mail.{{ d }}{% endfor %}

# Validate recipients: aliases, system users, virtual address map
local_recipient_maps = $alias_maps unix:passwd.byname $virtual_maps

# Virtual address map — redirects user@domain to local system username
virtual_maps = hash:{{ postfix_config_dir }}/virtual

# Deliver all local mailboxes via Dovecot LMTP (writes to ~/Maildir)
mailbox_transport = lmtp:unix:private/dovecot-lmtp
home_mailbox = Maildir/

# Subaddressing (user+tag@domain)
recipient_delimiter = +

# TLS — inbound (smtpd)
smtpd_tls_cert_file = {{ certbot_cert_dir }}/{{ mail_hostname }}/fullchain.pem
smtpd_tls_key_file  = {{ certbot_cert_dir }}/{{ mail_hostname }}/privkey.pem
smtpd_tls_CApath = /etc/ssl/certs
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = high
smtpd_tls_ciphers = high
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache

# TLS — outbound (smtp) with DANE
# Requires a local validating DNSSEC resolver (see setup_unbound role).
# 'dane' falls back to 'encrypt' for DNSSEC-signed domains without TLSA,
# and to 'may' for unsigned domains — never downgrades silently.
smtp_tls_security_level = dane
smtp_dns_support_level = dnssec
smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_mandatory_ciphers = high
smtp_tls_loglevel = 1
smtp_tls_note_starttls_offer = yes
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# TLS — shared settings
tls_high_cipherlist = ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
# NO_COMPRESSION: SMTP is not at risk of CRIME; reduces CPU overhead
# NO_RENEGOTIATION: closes CPU-exhaustion attack surface
tls_ssl_options = NO_COMPRESSION, NO_RENEGOTIATION

# SASL auth via Dovecot
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous

# SMTP hardening
smtpd_helo_required = yes
smtpd_delay_reject = yes
strict_rfc821_envelopes = yes
smtpd_error_sleep_time = 20s
smtpd_recipient_limit = 300
show_user_unknown_table_name = no

# Restriction stages
smtpd_data_restrictions =
    reject_unauth_pipelining,
    permit

smtpd_helo_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname,
    reject_unknown_helo_hostname

smtpd_sender_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unknown_sender_domain

smtpd_recipient_restrictions =
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    reject_unauth_pipelining,
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, defer_unauth_destination

# Milters:
#   - Rspamd: spam scoring + DKIM sign/verify + SPF + greylisting (inbound and submission)
#   - OpenDMARC: inbound DMARC policy enforcement (port 25 only via master.cf override on submission)
# milter_default_action = tempfail: if a milter is down, defer rather than silently skip checks
milter_default_action = tempfail
milter_protocol = 6
smtpd_milters = inet:127.0.0.1:11332, local:/run/opendmarc/opendmarc.sock
# non_smtpd_milters intentionally empty: locally-injected mail (cron, bounces) bypasses
# milter processing — rspamd greylists localhost, and opendmarc on outbound is meaningless
non_smtpd_milters =

# Postscreen — connection-level DNSBL filtering before smtpd accepts the session
postscreen_access_list = permit_mynetworks
postscreen_blacklist_action = drop
postscreen_dnsbl_action = enforce
postscreen_greet_action = enforce
postscreen_bare_newline_action = enforce
postscreen_dnsbl_whitelist_threshold = -1
postscreen_dnsbl_sites = {{ postscreen_dnsbl_sites | join(', ') }}
postscreen_dnsbl_threshold = {{ postscreen_dnsbl_threshold }}

# Queue lifetime
maximal_queue_lifetime = 3d
bounce_queue_lifetime = 3d

# Limits
message_size_limit = 52428800
mailbox_size_limit = 0
