# Managed by Ansible — do not edit manually
# Dovecot 2.4 configuration
dovecot_config_version = 2.4.1
dovecot_storage_version = 2.4.1

protocols = imap lmtp

# Virtual mailbox: all mail stored under vmail_home/<domain>/<user>/Maildir/
mail_driver = maildir
mail_path = {{ vmail_home }}/%d/%n/Maildir
mail_uid = {{ vmail_uid }}
mail_gid = {{ vmail_gid }}
first_valid_uid = {{ vmail_uid }}
last_valid_uid = {{ vmail_uid }}

# Virtual user auth — passwords in /etc/dovecot/users (SHA512-CRYPT, managed by Ansible)
auth_mechanisms = plain login
auth_allow_cleartext = no

passdb {
  driver = passwd-file
  args = scheme=SHA512-CRYPT /etc/dovecot/users
}

userdb {
  driver = static
  args = uid={{ vmail_uid }} gid={{ vmail_gid }} home={{ vmail_home }}/%d/%n
}

service imap-login {
  inet_listener imap {
    port = 0       # IMAP+STARTTLS disabled — IMAPS only
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
  unix_listener auth-userdb {
    mode = 0600
    user = {{ vmail_user }}
  }
}

!include conf.d/10-ssl.conf
!include conf.d/90-fts.conf
