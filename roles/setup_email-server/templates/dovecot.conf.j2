# Managed by Ansible — do not edit manually
# Dovecot 2.4 configuration — PAM auth, system user mailboxes
dovecot_config_version = 2.4.1
dovecot_storage_version = 2.4.1

protocols = imap lmtp

# System user mailboxes — Maildir in each user's home directory
mail_driver = maildir
mail_path = ~/Maildir
mail_privileged_group = mail

# Folders and their special-use flags, so mail clients find Drafts, Junk, Sent and Trash.
# Maildir++ keeps the "." separator, matching folders created by older Dovecot/Courier.
namespace inbox {
  inbox = yes
  separator = .

  mailbox Drafts {
    special_use = \Drafts
  }
  mailbox Junk {
    special_use = \Junk
  }
  mailbox Trash {
    special_use = \Trash
  }
  mailbox Sent {
    special_use = \Sent
  }
}
{% if email_sieve_enabled | bool %}

# Sieve filtering at delivery (replaces procmail): one script per user, ~/.dovecot.sieve
protocol lmtp {
  mail_plugins {
    sieve = yes
  }
}

sieve_script personal {
  driver = file
  path = ~/sieve
  active_path = ~/.dovecot.sieve
}
{% endif %}

# Reject cleartext auth over unencrypted connections
auth_mechanisms = plain login
auth_allow_cleartext = no

# Mailboxes are system users, so a recipient like user@domain (Postfix passes the full
# address to LMTP) and a login name map to the same account: drop the domain part.
auth_username_format = %{user | username | lower}

# PAM password authentication (validates via /etc/shadow)
passdb pam {
}

# System user database — home dir, uid/gid from /etc/passwd
userdb passwd {
}

service imap-login {
  inet_listener imap {
    port = 0       # IMAP+STARTTLS disabled — IMAPS only
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
  unix_listener auth-userdb {
    mode = 0600
  }
}

!include conf.d/10-ssl.conf
!include conf.d/90-fts.conf
