# Managed by Ansible — do not edit manually
# Dovecot 2.4 FTS configuration via dovecot-fts-xapian.
#
# After first deploy or adding mailboxes, trigger a full index:
#   doveadm fts rescan -A
#   doveadm index -A -q '*'

# Load FTS + Xapian plugin for IMAP sessions
mail_plugins = fts fts_xapian

# Automatically index new mail on arrival
fts_autoindex = yes
fts_autoindex_max_recent_msgs = 999
fts_search_add_missing = yes

# Skip indexing these folders — rarely searched, saves index space and CPU
fts_autoindex_exclude = \Trash
fts_autoindex_exclude2 = \Junk

# Dovecot 2.4 requires at least one language block for FTS
language "en" {
  default = yes
}

# Xapian backend settings
fts xapian {
  partial = 3
  verbose = 0
  maxthreads = 2
  # Memory (MB) to buffer before committing to disk; lower = less RAM pressure
  lowmemory = 200
}

service indexer-worker {
  # Xapian can use significant RAM during reindex; cap below OOM threshold
  vsz_limit = 1G
}
