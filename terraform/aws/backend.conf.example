# Copy to backend.conf (gitignored) and fill in your values.
# Usage: terraform init -backend-config=backend.conf
#
# bucket name format: <name>-<region>-<environment>-<account-id>
bucket = "your-tfstate-bucket-name"
key    = "aws/terraform.tfstate"
region = "eu-west-1"

# Optional: enable state locking
dynamodb_table = "terraform-state-lock"
encrypt        = true
