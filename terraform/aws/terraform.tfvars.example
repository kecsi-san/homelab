# Copy to terraform.tfvars (gitignored) and fill in your values.

aws_region    = "eu-west-1"
instance_type = "t3.small"
key_pair_name = "your-aws-keypair-name"
admin_user    = "admin"

# Domains whose MX/SPF/DMARC records are managed in Route53
email_domains = ["example.com", "example.net"]

# Existing S3 bucket names to import and manage
s3_bucket_names = []
