# Copy to terraform.tfvars (gitignored) and fill in your values.

aws_region           = "eu-west-1"
instance_type        = "t3a.small"
key_pair_name        = "your-aws-keypair-name"
admin_user           = "admin"
vpc_id               = "vpc-xxxxxxxx"
subnet_id            = "subnet-xxxxxxxx"
iam_instance_profile = "your-instance-profile-name"  # leave empty string if none

# edge_ssh_user = "kecsi"                          # default shown; SSH user cloud-init creates on edge.kecskemethy.net
# vault_address = "https://vault.kecskemethy.hu"   # default shown

# Domains with Route53 hosted zones — MX, SPF, DMARC records created for each
route53_domains = ["example.com", "example.net"]

# FQDN of the mail server; A record created in its parent zone
mail_hostname = "mail.example.com"

# Existing S3 bucket names to import and manage
s3_bucket_names = []
